{
  "name": "easy-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "echo \"pnpm test:e2e: not yet implemented (see issue #32)\"",
    "dev": "vite",
    "build": "vite build",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate:config && pnpm test && pnpm build",
    "validate:config": "tsx scripts/validate/cli-config.ts",
    "validate:data": "tsx scripts/validate/cli.ts",
    "start": "tsx scripts/start/cli.ts",
    "collect": "tsx scripts/collect/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mantine/colors-generator": "9.5.1",
    "@types/express": "5.0.6",
    "@types/node": "^24.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "postcss": "8.5.26",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "^3.9.6",
    "supertest": "7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.29",
    "express": "5.2.1",
    "feedsmith": "2.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  }
}
